rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'brunogarciawork@gmail.com';
    }

    function isShortString(value, maxLength) {
      return value is string && value.size() <= maxLength;
    }

    function isValidEvent() {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'eventType', 'dayType', 'ctaId', 'groupId', 'path', 'sessionId', 'source',
          'medium', 'campaign', 'referrerHost', 'screen', 'createdAt'
        ])
        && data.keys().hasAll([
          'eventType', 'dayType', 'ctaId', 'groupId', 'path', 'sessionId', 'source',
          'medium', 'campaign', 'referrerHost', 'screen', 'createdAt'
        ])
        && data.eventType in ['page_view', 'session_start', 'cta_click']
        && isShortString(data.dayType, 40)
        && data.dayType.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}:(page_view|session_start|cta_click)$')
        && isShortString(data.ctaId, 30)
        && isShortString(data.groupId, 64)
        && (
          (data.eventType == 'cta_click'
            && data.ctaId in ['cta-top', 'cta-main', 'cta-final', 'cta-sticky']
            && data.groupId.matches('^[A-Za-z0-9_-]{1,64}$'))
          || (data.eventType != 'cta_click' && data.ctaId == '' && data.groupId == '')
        )
        && data.path in ['/', '/index.html']
        && data.sessionId is string
        && data.sessionId.matches('^[A-Za-z0-9_-]{16,64}$')
        && isShortString(data.source, 100)
        && isShortString(data.medium, 100)
        && isShortString(data.campaign, 100)
        && isShortString(data.referrerHost, 160)
        && isShortString(data.screen, 30)
        && data.screen.matches('^[0-9]{2,5}x[0-9]{2,5}$')
        && data.createdAt is timestamp
        && data.createdAt >= request.time - duration.value(10, 'm')
        && data.createdAt <= request.time + duration.value(10, 'm');
    }

    function isDeterministicEventId(eventId) {
      let data = request.resource.data;
      return eventId.matches('^[A-Za-z0-9_-]{20,64}$')
        && (
          (data.eventType == 'session_start' && eventId == data.sessionId + '_session')
          || (data.eventType == 'page_view' && eventId == data.sessionId + '_view')
          || (data.eventType == 'cta_click' && eventId == data.sessionId + '_click')
        );
    }

    function isValidCounterIncrement(groupId) {
      let data = request.resource.data;
      let eventId = data.lastEventId;
      let eventPath = /databases/$(database)/documents/events/$(eventId);
      return data.keys().hasAll([
          'groupId', 'revision', 'clicks', 'baselineMembers', 'switchAt',
          'lastEventId', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'groupId', 'revision', 'clicks', 'baselineMembers', 'switchAt',
          'lastEventId', 'createdAt', 'updatedAt'
        ])
        && data.diff(resource.data).affectedKeys().hasOnly(['clicks', 'lastEventId', 'updatedAt'])
        && data.groupId == groupId
        && data.groupId == resource.data.groupId
        && data.groupId.matches('^[A-Za-z0-9_-]{1,64}$')
        && data.revision == resource.data.revision
        && isShortString(data.revision, 64)
        && data.clicks is int
        && data.clicks == resource.data.clicks + 1
        && data.baselineMembers is int
        && data.baselineMembers >= 0
        && data.baselineMembers <= 2000
        && data.switchAt is int
        && data.switchAt > data.baselineMembers
        && data.switchAt <= 2000
        && resource.data.baselineMembers + resource.data.clicks < resource.data.switchAt
        && data.baselineMembers + data.clicks <= data.switchAt
        && data.lastEventId is string
        && data.lastEventId.matches('^[A-Za-z0-9_-]{16,58}_click$')
        && data.updatedAt == request.time
        && !exists(eventPath)
        && existsAfter(eventPath)
        && getAfter(eventPath).data.eventType == 'cta_click'
        && getAfter(eventPath).data.groupId == groupId
        && getAfter(eventPath).data.sessionId + '_click' == eventId;
    }

    match /events/{eventId} {
      allow create: if isValidEvent() && isDeterministicEventId(eventId);
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    match /settings/groups {
      allow read: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /public/site {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /routingCounters/{groupId} {
      allow get: if true;
      allow list: if isAdmin();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || isValidCounterIncrement(groupId);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
